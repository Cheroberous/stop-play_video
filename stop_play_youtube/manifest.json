{
  "manifest_version": 3,
  "name": "Manage_video",
  "version": "1.4.0",
  "description": "Manage videos from everywhere",

  "background": {
    "service_worker": "background.js"
  }, 

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at" : "document_start",
      "js": ["contentScript.js"]
    }
  ],
  
  "host_permissions": ["https://www.youtube.com/*"],

  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  }

  
}
